# Скопируйте в .env (локально) или задайте переменные в панели bothost. НЕ коммитьте .env.
# Комментарии пишите на отдельных строках, после значения — не нужно.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш числовой Telegram ID (узнать: @userinfobot)
OWNER_ID=
# Ещё разрешённые ID через запятую, необязательно
ALLOWED_USER_IDS=
# Ключ NewsAPI, необязательно
NEWSAPI_KEY=
DIGEST_TIME=08:00
WEATHER_TIME=20:00
TZ=Europe/Moscow
LOG_LEVEL=INFO
REFRESH_MINUTES=30
TRANSLATE_DAILY_CHARS=200000
